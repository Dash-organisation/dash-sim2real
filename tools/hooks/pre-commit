#!/bin/sh
# Refuse staged files larger than 1 MiB, except deployed policies and warm-start checkpoints.
# Heavy outputs (videos, progress logs, archives, traces) go to dash-reports: tools/sync_reports.sh
# Bypass once, on purpose:  git commit --no-verify
LIMIT=1048576
big=$(git diff --cached --name-only --diff-filter=AM -z | xargs -0 -I{} sh -c '
  case "$1" in
    controller/deploy/bundles/*.npz|checkpoints/*/best.msgpack|checkpoints/*/*/best.msgpack) exit 0 ;;
  esac
  s=$(git cat-file -s ":$1" 2>/dev/null || echo 0)
  [ "$s" -gt '"$LIMIT"' ] && printf "  %s (%s KiB)\n" "$1" $((s / 1024))
  exit 0' _ {})
if [ -n "$big" ]; then
  echo "pre-commit: these staged files are larger than 1 MiB:" >&2
  echo "$big" >&2
  echo "Heavy files belong in dash-reports (tools/sync_reports.sh). Unstage them with: git restore --staged <file>" >&2
  exit 1
fi
